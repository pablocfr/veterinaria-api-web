@model VeterinariaApp.Models.Historial

@{
    ViewData["Title"] = "Detalle del Historial";
    Layout = "~/Views/Shared/_LayoutVeterinaria.cshtml";
}

<h1>Detalle del Historial</h1>
<hr />

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h5 class="text-primary">Mascota</h5>
                <dl class="row">
                    <dt class="col-sm-5">Nombre</dt>
                    <dd class="col-sm-7">@Model.NombreMascota</dd>
                    <dt class="col-sm-5">Especie</dt>
                    <dd class="col-sm-7">@Model.EspecieMascota</dd>
                    <dt class="col-sm-5">Edad</dt>
                    <dd class="col-sm-7">@Model.EdadMascota años</dd>
                </dl>
            </div>

            <div class="col-md-6">
                <h5 class="text-primary">Cliente</h5>
                <dl class="row">
                    <dt class="col-sm-5">Nombre</dt>
                    <dd class="col-sm-7">@Model.NombreCliente</dd>
                    <dt class="col-sm-5">DNI</dt>
                    <dd class="col-sm-7">@Model.DniCliente</dd>
                </dl>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <h5 class="text-primary">Veterinario</h5>
                <dl class="row">
                    <dt class="col-sm-5">Nombre</dt>
                    <dd class="col-sm-7">@Model.NombreVeterinario</dd>
                    <dt class="col-sm-5">Especialidad</dt>
                    <dd class="col-sm-7">@Model.EspecialidadVeterinario</dd>
                </dl>
            </div>

            <div class="col-md-6">
                <h5 class="text-primary">Cita</h5>
                <dl class="row">
                    <dt class="col-sm-5">Fecha de Atención</dt>
                    <dd class="col-sm-7">@Model.FechaAtencion.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-sm-5">Motivo</dt>
                    <dd class="col-sm-7">@Model.MotivoCita</dd>
                    <dt class="col-sm-5">Estado</dt>
                    <dd class="col-sm-7">@Model.EstadoCita</dd>
                </dl>
            </div>
        </div>

        <hr />

        <h5 class="text-primary">Diagnóstico</h5>
        <p>@Model.Diagnostico</p>

        <h5 class="text-primary">Tratamiento</h5>
        <p>@Model.Tratamiento</p>

        <h5 class="text-primary">Observaciones</h5>
        <p>@Model.Observaciones</p>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver al listado</a>
</div>