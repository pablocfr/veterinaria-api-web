@model VeterinariaApp.Models.Cliente
@{
    ViewData["Title"] = "Nuevo Cliente";
    Layout = "~/Views/Shared/_LayoutVeterinaria.cshtml";
}

<form asp-action="Create" method="post" class="card shadow-sm border-0">
    @Html.AntiForgeryToken()

    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-person-plus fs-4 text-success"></i>
            <div>
                <h2 class="h5 mb-0">Nuevo Cliente</h2>
                <small class="text-muted">Completa la información y guarda para crear el registro.</small>
            </div>
        </div>
        <span class="badge rounded-pill text-bg-success">
            <i class="bi bi-check-circle me-1"></i> Estado inicial: Activo
        </span>
    </div>

    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

        <div class="row g-4">
            <!-- Columna principal -->
            <div class="col-12 col-lg-8">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Nombre" class="form-label fw-semibold">Nombre completo</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Pedro Sánchez" />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DNI" class="form-label fw-semibold">DNI</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-credit-card-2-front"></i></span>
                            <input asp-for="DNI" class="form-control" placeholder="Documento de identidad" />
                        </div>
                        <span asp-validation-for="DNI" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Telefono" class="form-label fw-semibold">Teléfono</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input asp-for="Telefono" class="form-control" placeholder="+51 1234 56789" />
                        </div>
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Correo" class="form-label fw-semibold">Correo</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Correo" class="form-control" type="email" placeholder="nombre@correo.com" />
                        </div>
                        <small class="text-muted">Usaremos este correo para notificaciones.</small>
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Direccion" class="form-label fw-semibold">Dirección</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                            <input asp-for="Direccion" class="form-control" placeholder="Calle, número, colonia, ciudad" />
                        </div>
                        <span asp-validation-for="Direccion" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Columna lateral -->
            <div class="col-12 col-lg-4">
                <div class="border rounded-3 p-3 bg-light h-100">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-info-circle me-2 text-secondary"></i>
                        <strong>Recomendaciones</strong>
                    </div>
                    <ul class="small mb-0 ps-3">
                        <li>Verifica nombre y correo antes de guardar.</li>
                        <li>El estado inicial del cliente será <strong>Activo</strong>.</li>
                        <li>Puedes editar el estado luego desde “Editar”.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer bg-white d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-circle"></i> Cancelar
        </a>
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check2-circle"></i> Guardar
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
