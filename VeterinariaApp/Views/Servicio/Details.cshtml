@model VeterinariaApp.Models.Servicio

@{
    ViewData["Title"] = "Detalle Servicio";
    Layout = "~/Views/Shared/_LayoutVeterinaria.cshtml";
}

<h1>Detalle Servicio</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.IdServicio)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.IdServicio)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nombre)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Nombre)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Descripcion)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Descripcion)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Precio)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Precio)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Estado)</dt>
    <dd class="col-sm-10">
        <span class="badge @(Model.Estado ? "bg-success" : "bg-danger")">
            @(Model.Estado ? "Activo" : "Inactivo")
        </span>
    </dd>
</dl>
<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.IdServicio" class="btn btn-primary btn-sm">✏️ Editar</a>
    <a asp-action="Index" class="btn btn-secondary btn-sm">📋 Volver</a>
</div>