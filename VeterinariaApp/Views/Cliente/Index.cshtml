@model IEnumerable<VeterinariaApp.Models.Cliente>
@{
    ViewData["Title"] = "Clientes (Vista Tabla)";
    Layout = "~/Views/Shared/_LayoutVeterinaria.cshtml";

    var filtro = (string)(ViewBag.nombre ?? "");
    bool soloActivos = (bool?)ViewBag.soloActivos ?? false;

    int paginaActual = (int?)ViewBag.paginaActual ?? 1;
    int totalPaginas = (int?)ViewBag.totalPaginas ?? 1;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
    <h1 class="fw-bold text-primary mb-0">
        <i class="bi bi-people"></i> Clientes
    </h1>

    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo Cliente
        </a>
    </div>
</div>

<!-- Buscador -->
<form asp-action="Index" method="get" class="card shadow-sm mb-3 border-0">
    <div class="card-body d-flex flex-column flex-md-row align-items-md-end gap-3">
        <div class="flex-grow-1">
            <label for="txtNombre" class="form-label fw-semibold mb-1">
                <i class="bi bi-search"></i> Buscar por nombre
            </label>
            <input id="txtNombre" name="nombre" value="@filtro" class="form-control" placeholder="Ej. Pedro Sánchez" />
        </div>
        <div class="form-check mt-4">
            <input class="form-check-input" type="checkbox" id="chkActivos" name="soloActivos" value="true" @(soloActivos ? "checked" : null) />
            <label class="form-check-label" for="chkActivos">
                Solo activos
            </label>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary mt-2 mt-md-0">
                <i class="bi bi-search"></i> Buscar
            </button>
            @if (!string.IsNullOrWhiteSpace(filtro) || soloActivos)
            {
                <a asp-action="Index" class="btn btn-outline-secondary mt-2 mt-md-0">
                    Quitar filtros
                </a>
            }
        </div>
    </div>
</form>

@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @err</div>
}

<div class="card shadow-sm">
    <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
        <span>Lista de Clientes</span>
        @if (!string.IsNullOrWhiteSpace(filtro) || soloActivos)
        {
            <span class="badge text-bg-info">Filtro: "@filtro" @(soloActivos ? " | Solo activos" : "")</span>
        }
    </div>
    <div class="card-body">
        @if (!(Model?.Any() ?? false))
        {
            <div class="alert alert-info text-center">
                @if (string.IsNullOrWhiteSpace(filtro) && !soloActivos)
                {
                    <span>No hay clientes registrados.</span>
                }
                else
                {
                    <span>No se encontraron clientes con el criterio dado.</span>
                }
            </div>
        }
        else
        {
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>DNI</th>
                        <th>Teléfono</th>
                        <th>Dirección</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th class="text-nowrap">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        var estadoBadge = c.Estado ? "success" : "secondary";
                        var estadoTxt = c.Estado ? "Activo" : "Inactivo";
                        <tr>
                            <td>@c.IdCliente</td>
                            <td class="fw-semibold">@c.Nombre</td>
                            <td>@c.DNI</td>
                            <td>@c.Telefono</td>
                            <td>@c.Direccion</td>
                            <td>@c.Correo</td>
                            <td><span class="badge rounded-pill bg-@estadoBadge">@estadoTxt</span></td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@c.IdCliente" class="btn btn-sm btn-primary" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@c.IdCliente" class="btn btn-sm btn-info text-white" title="Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@c.IdCliente" class="btn btn-sm btn-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- PAGINACIÓN (mantiene filtros) -->
<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(paginaActual - 1)"
               asp-route-nombre="@filtro"
               asp-route-soloActivos="@soloActivos">Anterior</a>
        </li>

        @for (int x = 1; x <= totalPaginas; x++)
        {
            <li class="page-item @(x == paginaActual ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@x"
                   asp-route-nombre="@filtro"
                   asp-route-soloActivos="@soloActivos">@x</a>
            </li>
        }

        <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(paginaActual + 1)"
               asp-route-nombre="@filtro"
               asp-route-soloActivos="@soloActivos">Siguiente</a>
        </li>
    </ul>
</nav>
