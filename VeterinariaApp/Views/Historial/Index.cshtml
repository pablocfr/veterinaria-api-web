@model IEnumerable<VeterinariaApp.Models.Historial>

@{
    ViewData["Title"] = "Historial Médico";
    Layout = "~/Views/Shared/_LayoutVeterinaria.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold text-primary mb-0"><i class="bi bi-file-medical"></i> Historial Médico</h1>
    <!-- Botón de búsqueda -->
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@ViewBag.search" placeholder="Buscar nombre de mascota" class="form-control" />
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty(ViewBag.search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light fw-semibold">Listado de historiales</div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center">No se encontraron historiales.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Mascota</th>
                            <th>Cliente</th>
                            <th>Veterinario</th>
                            <th>Fecha</th>
                            <th>Motivo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model)
                        {
                            <tr>
                                <td>@h.IdHistorial</td>
                                <td>@h.NombreMascota (@h.EspecieMascota)</td>
                                <td>@h.NombreCliente (@h.DniCliente)</td>
                                <td>@h.NombreVeterinario</td>
                                <td>@h.FechaAtencion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@h.MotivoCita</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@h.IdHistorial" class="btn btn-sm btn-info text-white">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Paginación -->
<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(ViewBag.paginaActual <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.paginaActual - 1)" asp-route-search="@ViewBag.search">Anterior</a>
        </li>
        @for (int x = 1; x <= ViewBag.totalPaginas; x++)
        {
            <li class="page-item @(x == ViewBag.paginaActual ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@x" asp-route-search="@ViewBag.search">@x</a>
            </li>
        }
        <li class="page-item @(ViewBag.paginaActual >= ViewBag.totalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.paginaActual + 1)" asp-route-search="@ViewBag.search">Siguiente</a>
        </li>
    </ul>
</nav>