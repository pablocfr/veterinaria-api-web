@model IEnumerable<VeterinariaApp.Models.Mascota>
@{
    ViewData["Title"] = "Mascotas (Vista Tabla)";
    Layout = "~/Views/Shared/_LayoutVeterinaria.cshtml";
    var filtro = (string)(ViewBag.nombre ?? "");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
    <h1 class="fw-bold text-primary mb-0">
        <i class="bi bi-paw"></i> Mascotas
    </h1>

    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva Mascota
        </a>
    </div>
</div>

<!-- Buscador -->
<form asp-action="Index" method="get" class="card shadow-sm mb-3 border-0">
    <div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-2">
        <div class="flex-grow-1">
            <label for="txtNombre" class="form-label fw-semibold mb-1">
                <i class="bi bi-search"></i> Buscar por nombre de la mascota
            </label>
            <input id="txtNombre" name="nombre" value="@filtro" class="form-control" placeholder="Ej. Firulais" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary mt-2 mt-md-4">
                <i class="bi bi-search"></i> Buscar
            </button>
            @if (!string.IsNullOrWhiteSpace(filtro))
            {
                <a asp-action="Index" class="btn btn-outline-secondary mt-2 mt-md-4">
                    Quitar filtro
                </a>
            }
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
        <span>Lista de Mascotas</span>
        @if (!string.IsNullOrWhiteSpace(filtro))
        {
            <span class="badge text-bg-info">Filtro: "@filtro"</span>
        }
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center">
                @if (string.IsNullOrWhiteSpace(filtro))
                {
                    <span>No hay mascotas registradas.</span>
                }
                else
                {
                    <span>No se encontraron mascotas para "<strong>@filtro</strong>".</span>
                }
            </div>
        }
        else
        {
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>Especie</th>
                        <th>Raza</th>
                        <th>Edad</th>
                        <th>Sexo</th>
                        <th>Cliente</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        var especieBadge = (m.Especie ?? "").ToLower() switch
                        {
                            "perro" => "primary",
                            "gato" => "info",
                            _ => "secondary"
                        };
                        var estadoBadge = m.Estado ? "success" : "secondary";
                        var estadoTxt = m.Estado ? "Activo" : "Inactivo";

                        <tr>
                            <td>@m.IdMascota</td>
                            <td class="fw-semibold">@m.Nombre</td>
                            <td><span class="badge bg-@especieBadge">@m.Especie</span></td>
                            <td>@m.Raza</td>
                            <td>@m.Edad</td>
                            <td>@m.Sexo</td>
                            
                            <td><span class="badge rounded-pill bg-@estadoBadge">@estadoTxt</span></td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@m.IdMascota" class="btn btn-sm btn-primary" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@m.IdMascota" class="btn btn-sm btn-info text-white" title="Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@m.IdMascota" class="btn btn-sm btn-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- PAGINACIÓN (mantiene el filtro) -->
<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(ViewBag.paginaActual <= 1 ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(ViewBag.paginaActual - 1)"
               asp-route-nombre="@filtro">Anterior</a>
        </li>

        @for (int x = 1; x <= (int)ViewBag.totalPaginas; x++)
        {
            <li class="page-item @(x == ViewBag.paginaActual ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@x"
                   asp-route-nombre="@filtro">@x</a>
            </li>
        }

        <li class="page-item @(ViewBag.paginaActual >= ViewBag.totalPaginas ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(ViewBag.paginaActual + 1)"
               asp-route-nombre="@filtro">Siguiente</a>
        </li>
    </ul>
</nav>
