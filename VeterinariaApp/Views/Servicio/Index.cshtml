@model IEnumerable<VeterinariaApp.Models.Servicio>

@{
    ViewData["Title"] = "Servicios";
    Layout = "~/Views/Shared/_LayoutVeterinaria.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold text-primary mb-0"><i class="bi bi-tools"></i> Servicios</h1>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nuevo Servicio</a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light fw-semibold">Lista de Servicios</div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center">No hay servicios registrados.</div>
        }
        else
        {
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Precio</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.IdServicio</td>
                            <td>@s.Nombre</td>
                            <td>@s.Descripcion</td>
                            <td>@s.Precio.ToString("C")</td>
                            <td>
                                <span class="badge @(s.Estado ? "bg-success" : "bg-danger")">
                                    @(s.Estado ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@s.IdServicio" class="btn btn-sm btn-primary"><i class="bi bi-pencil-square"></i></a>
                                <a asp-action="Details" asp-route-id="@s.IdServicio" class="btn btn-sm btn-info text-white"><i class="bi bi-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@s.IdServicio" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Paginación -->
<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(ViewBag.paginaActual <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.paginaActual - 1)">Anterior</a>
        </li>
        @for (int x = 1; x <= ViewBag.totalPaginas; x++)
        {
            <li class="page-item @(x == ViewBag.paginaActual ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@x">@x</a>
            </li>
        }
        <li class="page-item @(ViewBag.paginaActual >= ViewBag.totalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.paginaActual + 1)">Siguiente</a>
        </li>
    </ul>
</nav>