@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - VetCare</title>
    <!-- Framework CSS Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Tipografía principal del sistema -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Reseteo básico para compatibilidad */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Configuración principal del cuerpo */
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 20%, #90CAF9 40%, #64B5F6 60%, #42A5F5 80%, #2196F3 100%);
            background-attachment: fixed;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        /* Contenedor principal del formulario de acceso */
        .login-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1.5rem;
            padding: 1.5rem;
            width: 100%;
            max-width: 360px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        /* Área de marca y título */
        .brand-section {
            text-align: center;
            margin-bottom: 1.25rem;
        }

        /* Icono principal de la marca */
        .brand-icon {
            font-size: 3rem;
            color: #29B6F6;
            margin-bottom: 0.75rem;
            display: block;
        }

        /* Título principal del sistema */
        .brand-title {
            font-size: 1.8rem;
            font-weight: 600;
            color: #2196F3;
            margin-bottom: 0.5rem;
        }

        /* Subtítulo descriptivo */
        .brand-subtitle {
            color: #666;
            font-weight: 400;
            margin-bottom: 0.5rem;
        }

        /* Frase adicional de la marca */
        .brand-tagline {
            color: #999;
            font-size: 0.9rem;
            font-style: italic;
        }

        /* Grupos de campos del formulario */
        .form-group {
            margin-bottom: 1.25rem;
        }

        /* Etiquetas de los campos */
        .form-label {
            font-weight: 500;
            color: #555;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
        }

        /* Campos de entrada de datos */
        .form-control {
            border: 2px solid #e1f5fe;
            border-radius: 0.75rem;
            padding: 0.75rem 1rem 0.75rem 2.5rem;
            font-size: 1rem;
            background: rgba(248, 250, 252, 0.8);
            transition: all 0.3s ease;
        }

            /* Estado de foco de los campos */
            .form-control:focus {
                border-color: #29B6F6;
                box-shadow: 0 0 0 0.2rem rgba(41, 182, 246, 0.2);
                background: white;
                outline: none;
            }

        /* Contenedor de campo con icono */
        .input-group {
            position: relative;
        }

        /* Iconos dentro de los campos */
        .input-icon {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: #29B6F6;
            font-size: 1.1rem;
            z-index: 10;
        }

        /* Botón para mostrar/ocultar contraseña */
        .toggle-password {
            position: absolute;
            right: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #999;
            cursor: pointer;
            z-index: 10;
            padding: 0.25rem;
        }

            /* Efecto hover del botón toggle */
            .toggle-password:hover {
                color: #29B6F6;
            }

        /* Botón principal de ingreso */
        .btn-primary {
            background: linear-gradient(135deg, #29B6F6, #2196F3);
            border: none;
            border-radius: 0.75rem;
            padding: 0.75rem 2rem;
            font-weight: 500;
            font-size: 1rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            /* Efecto hover del botón principal */
            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(41, 182, 246, 0.3);
                background: linear-gradient(135deg, #2196F3, #1976D2);
            }

            /* Estado de foco del botón */
            .btn-primary:focus {
                box-shadow: 0 0 0 0.2rem rgba(41, 182, 246, 0.5);
            }

        /* Alertas de error */
        .alert {
            background: rgba(255, 235, 238, 0.9);
            border: 1px solid #ffcdd2;
            border-radius: 0.75rem;
            color: #c62828;
            padding: 0.75rem;
            margin-top: 1rem;
        }

        /* Sección inferior del formulario */
        .footer-section {
            text-align: center;
            margin-top: 1.5rem;
            padding-top: 1rem;
            border-top: 1px solid rgba(41, 182, 246, 0.1);
        }

        /* Indicador de seguridad */
        .security-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(76, 175, 80, 0.1);
            color: #4CAF50;
            padding: 0.25rem 0.75rem;
            border-radius: 2rem;
            font-size: 0.8rem;
            margin-bottom: 1rem;
        }

        /* Texto del pie de página */
        .footer-text {
            color: #666;
            font-size: 0.85rem;
        }

        /* Spinner de carga */
        .loading-spinner {
            display: none;
            width: 18px;
            height: 18px;
            border: 2px solid #ffffff;
            border-top: 2px solid transparent;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 0.5rem;
        }

        /* Animación del spinner */
        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Efecto sutil al pasar el cursor sobre la caja */
        .login-container:hover {
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        }

        /* Configuración para dispositivos móviles */
        @@media (max-width: 576px) {
            .login-container {
                margin: 1rem;
                padding: 1.25rem;
            }

            .brand-title {
                font-size: 1.6rem;
            }

            .brand-icon {
                font-size: 2.75rem;
            }
        }

        /* Mejoras de accesibilidad para navegación por teclado */
        .form-control:focus,
        .btn-primary:focus {
            outline: 2px solid #29B6F6;
            outline-offset: 2px;
        }

        /* Animación de entrada de la caja */
        .login-container {
            animation: fadeIn 0.6s ease-out;
        }

        @@keyframes fadeIn {
            0% {
                opacity: 0;
                transform: translateY(20px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Encabezado con información de la marca -->
        <div class="brand-section">
            <i class="bi bi-heart-pulse-fill brand-icon"></i>
            <h1 class="brand-title">VetCare</h1>
            <p class="brand-subtitle">Sistema Veterinario</p>
            <small class="brand-tagline">Cuidando con amor a tus mascotas</small>
        </div>

        <!-- Formulario de inicio de sesión -->
        @using (Html.BeginForm())
        {
            <form id="loginForm">
                <!-- Campo de usuario -->
                <div class="form-group">
                    <label class="form-label">
                        <i class="bi bi-person me-2"></i>
                        Usuario
                    </label>
                    <div class="input-group">
                        <input type="text" name="usuario" class="form-control" placeholder="Ingrese su usuario" required />
                        <i class="bi bi-person-fill input-icon"></i>
                    </div>
                </div>

                <!-- Campo de contraseña con opción de mostrar/ocultar -->
                <div class="form-group">
                    <label class="form-label">
                        <i class="bi bi-lock me-2"></i>
                        Contraseña
                    </label>
                    <div class="input-group">
                        <input type="password" name="clave" id="password" class="form-control" placeholder="Ingrese su contraseña" required />
                        <i class="bi bi-lock-fill input-icon"></i>
                        <button type="button" class="toggle-password" id="togglePassword">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Botón de envío del formulario -->
                <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center">
                    <div class="loading-spinner" id="loadingSpinner"></div>
                    <span id="buttonText">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Iniciar Sesión
                    </span>
                </button>
            </form>
        }

        <!-- Mensaje de error si existe -->
        @if (ViewBag.Mensaje != null)
        {
            <div class="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @ViewBag.Mensaje
            </div>
        }

        <!-- Pie de página con información adicional -->
        <div class="footer-section">
            <div class="security-badge">
                <i class="bi bi-shield-check me-1"></i>
                <span>Conexión Segura</span>
            </div>
            <div class="footer-text">
                © @DateTime.Now.Year VetCare. Todos los derechos reservados.
            </div>
            <div class="mt-1">
                <small class="text-muted">
                    <i class="bi bi-heart text-danger me-1"></i>
                    Con amor por los animales
                </small>
            </div>
        </div>
    </div>

    <!-- Framework JavaScript Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Funcionalidad para mostrar u ocultar la contraseña
        document.getElementById('togglePassword').addEventListener('click', function() {
            const campoPassword = document.getElementById('password');
            const iconoOjo = this.querySelector('i');

            if (campoPassword.type === 'password') {
                campoPassword.type = 'text';
                iconoOjo.className = 'bi bi-eye-slash';
            } else {
                campoPassword.type = 'password';
                iconoOjo.className = 'bi bi-eye';
            }
        });

        // Manejo del envío del formulario con estado de carga
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            const botonEnvio = document.querySelector('.btn-primary');
            const spinnerCarga = document.getElementById('loadingSpinner');
            const textoBoton = document.getElementById('buttonText');

            // Mostrar estado de carga mientras se procesa
            spinnerCarga.style.display = 'block';
            textoBoton.innerHTML = 'Verificando...';
            botonEnvio.disabled = true;
        });

        // Navegación mejorada con el teclado
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                const elementoActivo = document.activeElement;
                if (elementoActivo.name === 'usuario') {
                    document.querySelector('input[name="clave"]').focus();
                    e.preventDefault();
                }
            }
        });

        // Efectos visuales suaves en los campos de entrada
        document.querySelectorAll('.form-control').forEach(function(campo) {
            campo.addEventListener('focus', function() {
                this.style.transform = 'scale(1.02)';
            });

            campo.addEventListener('blur', function() {
                this.style.transform = 'scale(1)';
            });
        });
    </script>
</body>
</html>